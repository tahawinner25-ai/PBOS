# Copy to .env.local for development. In production set these in Vercel (Project → Settings → Environment Variables).
# Never commit real values. Only NEXT_PUBLIC_* variables are visible to the browser.
# `npm run gen-keys` prints fresh random values for every secret marked GENERATE below.

# ── Clerk (sign-in) ──────────────────────────────────────────────────────
# Clerk Dashboard → API keys. The publishable key is safe for the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
CLERK_SECRET_KEY=
# "Continue with Google" is switched on in the Clerk Dashboard, not here. See docs/AUTH-GOOGLE.md.

# ── Supabase (database and file storage) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# The anon key is safe in the browser (row-level security protects the data).
# A publishable key (sb_publishable_...) also works: set NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses row-level security. Used for the public media kit, the contact form,
# signed upload/download links, the private-mode guard and cron jobs. Without it, media upload is off.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (server only) ─────────────────────────────────────────────────────
# Without a key the app still runs: the daily review falls back to rules and AI buttons say AI is not set up.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Agent requests per creator per day (default 30). Needs SUPABASE_SERVICE_ROLE_KEY to count them.
AGENT_DAILY_LIMIT=30
# Image generation (Library). Without a key the image button explains that it is not set up.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
IMAGE_DAILY_LIMIT=10

# ── Site and company (shown on the legal pages) ──────────────────────────
# Canonical URL, sitemap, Open Graph, OAuth redirect URLs. No trailing slash. Must be the real https URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
# Anything left empty shows as a [bracketed placeholder] on /privacy and /terms until you fill it in.
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_GOVERNING_LAW=
# Optional privacy-friendly analytics (Plausible). Loads only after the visitor accepts analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Who can sign up ──────────────────────────────────────────────────────
# Sign-up is OPEN by default: every creator's rows are isolated by row-level security.
# Set to "true" to run a private instance where a profile can be created only while none exists.
# (Also set Clerk → Restrictions → Sign-up mode to "Restricted".)
SINGLE_CREATOR_MODE=false
# Optional: pin which creator the public /work-with-me page shows.
PUBLIC_CREATOR_ID=

# ── Cloudflare ───────────────────────────────────────────────────────────
# Turnstile protects the public contact form and the demo start. Set both keys together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# "true" ONLY when the site is served through Cloudflare's proxy (orange cloud), so the visitor IP is read from cf-connecting-ip.
TRUST_CLOUDFLARE=false

# ── Content-Security-Policy ──────────────────────────────────────────────
# "true" logs violations in the browser console without blocking anything (use it to investigate a blocked script).
CSP_REPORT_ONLY=false

# ── Demo (10-minute locked demo at /demo) ────────────────────────────────
# GENERATE. At least 32 characters. Signs the demo session cookie. Without it the demo says it is not available.
DEMO_SESSION_SECRET=

# ── YouTube and Instagram connections (see docs/INTEGRATIONS.md) ─────────
# GENERATE. One or more "version:base64-32-byte-key" pairs, newest first, e.g. 2:<new>,1:<old>.
# Encrypts every stored access/refresh token (AES-256-GCM). Losing it means everyone must reconnect.
TOKEN_ENCRYPTION_KEYS=
# GENERATE. At least 32 characters. Signs the OAuth state cookie.
OAUTH_STATE_SECRET=
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta for Developers → your app → Settings → Basic.
META_APP_ID=
META_APP_SECRET=
# Optional: only if you use Facebook Login for Business (a configuration id).
META_LOGIN_CONFIG_ID=
# Optional: pin the Graph API version (the code has a default).
META_GRAPH_VERSION=
# GENERATE. Any random string you also enter in Meta's webhook settings.
META_WEBHOOK_VERIFY_TOKEN=
# Optional YouTube quota guards (defaults are conservative).
YOUTUBE_QUOTA_DAILY_UNITS=
YOUTUBE_UPLOAD_DAILY_LIMIT=

# ── Scheduled jobs ───────────────────────────────────────────────────────
# GENERATE. At least 24 characters. The /api/cron/* endpoints accept only "Authorization: Bearer <this>".
# Instagram scheduled posts only go out if something calls /api/cron/publish every few minutes (docs/INTEGRATIONS.md).
CRON_SECRET=
