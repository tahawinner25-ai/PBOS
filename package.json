{
  "name": "pbos",
  "version": "0.1.0",
  "private": true,
  "description": "PBOS \u2014 Personal Brand Operating System. A single-creator AI operator for ideation, posting, analytics, deals and revenue.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:rls": "bash scripts/test-rls.sh",
    "check:links": "node scripts/check-links.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run typecheck && npm run typecheck:tests && npm run lint && npm test && npm run check:secrets && npm run check:links && npm run audit:security",
    "gen-keys": "node scripts/gen-keys.mjs",
    "test:browser": "echo \"Browser tests need Chromium and ffmpeg: see tools/browser-tests/README.md\"",
    "audit:security": "node scripts/security-audit.mjs",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.0.0",
    "@clerk/themes": "^2.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@supabase/supabase-js": "^2.49.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.446.0",
    "next": "15.5.28",
    "react": "^19.1.4",
    "react-dom": "^19.1.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    }
  }
}
